# Polite-pool identity - higher rate limits on NCBI, OpenAlex, Unpaywall, Crossref
ARLANDRIA_EMAIL=you@university.edu

# REQUIRED for OpenAlex (the default search backbone) since 2026-02-13.
# Without it, `search.py --source openalex` errors (or pass --no-api-key for the keyless pool).
OPENALEX_API_KEY=

# Fallback base directory for new review folders (default: ~/arlandria-reviews).
# The agent asks where to save each review at creation, so this is only the default.
# ARLANDRIA_HOME=~/arlandria-reviews

# Optional: Semantic Scholar API key for higher search.py rate limits
# S2_API_KEY=
