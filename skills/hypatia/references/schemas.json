          "type": "object",
          "required": [
            "id",
            "statement",
            "claim_ids",
            "status",
            "currency"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "claim_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
