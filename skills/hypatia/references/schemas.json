              "properties": {
                "checked_source_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "claim_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]+$"
                  }
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "opportunities": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "gap_id",
            "direction_claim_ids",
            "feasibility"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "gap_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "direction_claim_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "feasibility": {
              "type": "object",
              "required": [
                "effort",
                "rationale",
                "prerequisites",
                "unknowns",
                "resource_ids"
              ],
              "properties": {
                "effort": {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "unknown"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "prerequisites": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "unknowns": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "resource_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]+$"
                  },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "source_reviews": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "source_id",
            "status",
            "note"
          ],
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "reviewed",
                "unreadable"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "Extraction": {
    "type": "object",
