          "type": "object",
          "required": [
            "record_id",
            "kind",
            "artifact",
            "limitation",
            "warnings"
          ],
          "properties": {
            "record_id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "fulltext",
                "abstract"
              ]
            },
            "artifact": {
              "type": "string",
              "minLength": 1
            },
            "limitation": {
              "type": "string"
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "artifacts": {
        "type": "object",
        "patternProperties": {
          "^.*$": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "seal": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false
  },
  "Ledger": {
    "type": "object",
    "required": [
      "review_id",
      "question",
      "criteria",
      "queries",
      "records"
    ],
    "properties": {
      "review_id": {
        "type": "string",
        "minLength": 1
      },
      "question": {
        "type": "string",
        "minLength": 1
      },
      "criteria": {
        "type": "object",
        "required": [
          "version",
          "include",
          "exclude"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      },
      "queries": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "round",
            "source",
            "query_string",
            "run_at",
            "n_returned"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "round": {
              "type": "integer",
              "minimum": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "query_string": {
              "type": "string",
              "minLength": 1
            },
            "run_at": {
              "type": "string",
              "minLength": 1
            },
            "n_returned": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "records": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "title",
            "abstract",
            "year",
            "doi",
            "authors",
            "status",
            "screening"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "abstract": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "year": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "doi": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "authors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "enum": [
                "active",
                "deferred"
              ]
            },
            "screening": {
              "type": "object",
              "required": [
                "abstract",
                "fulltext"
              ],
              "properties": {
                "abstract": {
                  "type": "object",
                  "required": [
                    "decision",
                    "reason",
                    "criteria_version",
                    "decided_by"
                  ],
                  "properties": {
                    "decision": {
                      "enum": [
                        "unscreened",
                        "include",
                        "exclude",
                        "borderline",
                        "not_applicable"
                      ]
                    },
                    "reason": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "criteria_version": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "decided_by": {
                      "enum": [
                        "llm",
                        "human"
                      ]
                    }
                  }
                },
                "fulltext": {
                  "type": "object",
                  "required": [
                    "decision",
                    "reason",
                    "criteria_version",
                    "decided_by"
                  ],
                  "properties": {
                    "decision": {
                      "enum": [
                        "unscreened",
                        "include",
                        "exclude",
                        "borderline",
                        "not_applicable"
                      ]
                    },
                    "reason": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "criteria_version": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "decided_by": {
                      "enum": [
                        "llm",
                        "human"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
