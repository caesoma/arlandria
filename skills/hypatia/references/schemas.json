            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "Evidence": {
    "type": "object",
    "required": [
      "schema_version",
      "handoff_revision",
