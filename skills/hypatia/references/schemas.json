  "Handoff": {
    "type": "object",
    "required": [
      "schema_version",
      "producer",
      "status",
      "run_id",
      "review_id",
      "revision",
      "completed_at",
      "criteria_version",
      "cutoff",
      "ledger_sha256",
      "sources_sha256",
      "included_ids",
      "stages",
      "gates",
      "sources",
      "artifacts",
      "seal"
    ],
    "properties": {
      "schema_version": {
        "type": "number",
        "const": 1
      },
      "producer": {
        "type": "string",
        "const": "callimachus"
      },
      "status": {
        "type": "string",
        "const": "completed"
      },
      "run_id": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "review_id": {
        "type": "string",
        "minLength": 1
      },
      "revision": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "completed_at": {
        "type": "string",
        "minLength": 1
      },
      "criteria_version": {
        "type": "integer",
        "minimum": 1
      },
      "cutoff": {
        "type": "string",
        "minLength": 1
      },
      "ledger_sha256": {
        "type": "string",
        "minLength": 1
      },
      "sources_sha256": {
        "type": "string",
        "minLength": 1
      },
      "included_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "stages": {
        "type": "object",
        "required": [
          "question",
          "criteria",
          "query",
          "pool",
          "screen",
          "triage",
          "refine",
          "export",
          "curation"
        ],
        "properties": {
          "question": {
            "type": "string",
            "const": "completed"
          },
          "criteria": {
            "type": "string",
            "const": "completed"
          },
          "query": {
            "type": "string",
            "const": "completed"
          },
          "pool": {
            "type": "string",
            "const": "completed"
          },
          "screen": {
            "type": "string",
            "const": "completed"
          },
          "triage": {
            "type": "string",
            "const": "completed"
          },
          "refine": {
            "type": "string",
            "const": "completed"
          },
          "export": {
            "type": "string",
            "const": "completed"
          },
          "curation": {
            "type": "string",
            "const": "completed"
          }
        },
        "additionalProperties": false
      },
      "gates": {
        "type": "object",
        "required": [
          "criteria",
          "triage",
          "curation"
        ],
        "properties": {
          "criteria": {
            "type": "string",
            "minLength": 1
          },
          "triage": {
            "type": "string",
            "minLength": 1
          },
          "curation": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
